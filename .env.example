# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only Supabase key
SUPABASE_SERVICE_ROLE_KEY=

# Admin authorization lives in public.admin_users in Supabase.
# Do not place admin email addresses in public client variables.

# Inventory vault encryption.
# Version 1 may use INVENTORY_ENCRYPTION_KEY for backwards compatibility.
# For future rotations, add INVENTORY_ENCRYPTION_KEY_V2, V3, etc. and then
# change INVENTORY_ENCRYPTION_KEY_VERSION only after the new secret exists.
INVENTORY_ENCRYPTION_KEY_VERSION=1
INVENTORY_ENCRYPTION_KEY=
# INVENTORY_ENCRYPTION_KEY_V2=

# Paystack. Start with sk_test_... and only use live after launch QA.
PAYSTACK_SECRET_KEY=

# A live Paystack key remains blocked unless BOTH switches below are true.
PAYSTACK_LIVE_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Canonical base URL, e.g. https://dropke.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000
