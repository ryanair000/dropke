# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only Supabase key
SUPABASE_SERVICE_ROLE_KEY=

# Admin access. The owner email is also hard-coded as the initial allowlisted admin.
DROPKE_ADMIN_EMAILS=nitradefc24p@gmail.com

# Long random secret used to derive the AES-256-GCM inventory key.
INVENTORY_ENCRYPTION_KEY=

# Paystack. Start with sk_test_... and only use live after launch QA.
PAYSTACK_SECRET_KEY=

# Canonical base URL, e.g. https://dropke.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional checkout switch. Keep false until payment testing starts.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
